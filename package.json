{
  "name": "lavka-roz-frontend",
  "version": "1.2.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open --port 4220",
    "build": "ng build --aot --configuration production --build-optimizer --common-chunk --optimization",
    "build-with-deploy": "npm run build && firebase deploy",
    "watch": "ng build --watch --configuration development",
    "test": "jest --verbose --maxConcurrency=1024",
    "test:watch": "jest --watch",
    "eslint:fix": "eslint . --ext .ts,.js --fix --quiet",
    "eslint-all": "eslint . --ext .ts,.js --quiet",
    "prepare": "husky install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,js}": "eslint --fix"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.6",
    "@angular/cdk": "^17.3.6",
    "@angular/common": "^17.3.6",
    "@angular/compiler": "^17.3.6",
    "@angular/core": "^17.3.6",
    "@angular/forms": "^17.3.6",
    "@angular/platform-browser": "^17.3.6",
    "@angular/platform-browser-dynamic": "^17.3.6",
    "@angular/router": "^17.3.6",
    "@datorama/akita": "^8.0.1",
    "@datorama/akita-ngdevtools": "^7.0.0",
    "@ngneat/forms-manager": "^2.5.1",
    "@ngneat/until-destroy": "^10.0.0",
    "rxjs": "~7.8.1",
    "socket.io-client": "^4.7.2",
    "zone.js": "~0.14.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.5",
    "firebase-tools": "^13.0.2",
    "@angular-eslint/builder": "^17.3.0",
    "@angular-eslint/eslint-plugin": "^17.3.0",
    "@angular-eslint/eslint-plugin-template": "^17.3.0",
    "@angular-eslint/schematics": "^17.3.0",
    "@angular-eslint/template-parser": "^17.3.0",
    "@angular/cli": "^17.3.6",
    "@angular/compiler-cli": "^17.3.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/eslint-plugin-tslint": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "eslint": "8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-billing-rmi-rules": "file:rules",
    "eslint-plugin-local-rules": "^2.0.1",
    "eslint-plugin-prettier": "^5.1.2",
    "eslint-plugin-sort-imports-es6-autofix": "^0.6.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.0.3",
    "lint-staged": "^15.2.2",
    "prettier": "3.2.5",
    "stylelint-config-prettier": "^9.0.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.4.2"
  }
}

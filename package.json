        "@types/node": "^12.11.1",
        "@typescript-eslint/eslint-plugin": "^5.54.0",
        "@typescript-eslint/eslint-plugin-tslint": "^5.54.0",
        "@typescript-eslint/parser": "^5.54.0",
        "eslint": "^8.35.0",
        "eslint-config-prettier": "^8.6.0",
        "eslint-plugin-billing-rmi-rules": "file:rules",

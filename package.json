{
  "name": "lavka-roz-frontend",
  "version": "1.2.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --open --port 4220",
    "build": "ng build --aot --configuration production --build-optimizer --common-chunk --optimization",
    "build-with-deploy": "npm run build && firebase deploy",
    "watch": "ng build --watch --configuration development",
    "test": "jest --verbose --maxConcurrency=1024",
    "test:watch": "jest --watch",
    "eslint:fix": "eslint . --ext .ts,.js --fix --quiet",
    "eslint-all": "eslint . --ext .ts,.js --quiet",
    "prepare": "husky install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,js}": "eslint --fix"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.13",
    "@angular/cdk": "^18.2.14",
    "@angular/common": "^18.2.13",
    "@angular/compiler": "^18.2.13",
    "@angular/core": "^18.2.13",
    "@angular/forms": "^18.2.13",
    "@angular/platform-browser": "^18.2.13",
    "@angular/platform-browser-dynamic": "^18.2.13",
    "@angular/router": "^18.2.13",
    "@datorama/akita": "^8.0.1",
    "@datorama/akita-ngdevtools": "^7.0.0",
    "@ngneat/forms-manager": "^2.5.1",
    "@ngneat/until-destroy": "^10.0.0",
    "rxjs": "~7.8.1",
    "socket.io-client": "^4.7.2",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.12",
    "firebase-tools": "^13.0.2",
    "@angular-eslint/builder": "^18.4.3",
    "@angular-eslint/eslint-plugin": "^18.4.3",
    "@angular-eslint/eslint-plugin-template": "^18.4.3",
    "@angular-eslint/schematics": "^18.4.3",
    "@angular-eslint/template-parser": "^18.4.3",
    "@angular/cli": "^18.2.12",
    "@angular/compiler-cli": "^18.2.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/eslint-plugin-tslint": "^7.0.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-billing-rmi-rules": "file:rules",
    "eslint-plugin-local-rules": "^2.0.1",
    "eslint-plugin-prettier": "^5.1.2",
    "eslint-plugin-sort-imports-es6-autofix": "^0.6.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.4.2",
    "lint-staged": "^15.2.11",
    "prettier": "3.4.2",
    "stylelint-config-prettier": "^9.0.5",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.5.4"
  }
}

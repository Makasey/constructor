/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
    "compileOnSave": false,
    "compilerOptions": {
        "baseUrl": "./src",
        "outDir": "./dist/out-tsc",
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noImplicitOverride": false,
        "noPropertyAccessFromIndexSignature": false,
        "suppressImplicitAnyIndexErrors": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "strictPropertyInitialization": false,
        "sourceMap": true,
        "declaration": false,
        "experimentalDecorators": true,
        "moduleResolution": "node",
        "ignoreDeprecations": "5.0",
        "importHelpers": true,
        "target": "ES2022",
        "module": "es2020",
        "lib": ["es2020", "dom"],
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "skipDefaultLibCheck": true,
        "newLine": "lf",
        "resolveJsonModule": true,
        "useDefineForClassFields": false,
        "paths": {
            "@core/*": ["app/core/*"],
            "@core": ["app/core/index.ts"],
            "@components/*": ["app/components/*"],
            "@components": ["app/components/index.ts"],
            "@modules/*": ["app/module/*"],
            "@modules": ["app/module/index.ts"],
            "@shared-pipes/*": ["app/pipes/*"],
            "@shared-pipes": ["app/pipes/index.ts"],
            "@shared-types/*": ["app/types/*"],
            "@shared-types": ["app/types/index.ts"],
            "@shared-utils/*": ["app/utils/*"],
            "@shared-plugins": ["app/plugins"],
            "@shared-plugins/*": ["app/plugins/index.ts"],
            "@shared-decorators": ["app/decorators"],
            "@shared-decorators/*": ["app/decorators/index.ts"],
            "@shared-utils": ["app/utils/index.ts"],
            "@shared-directives/*": ["app/directive/*"],
            "@shared-directives": ["app/directive/index.ts"],
            "@shared-constants/*": ["app/constants/*"],
            "@shared-constants": ["app/constants/index.ts"],
            "@shared-enums/*": ["app/enums/*"],
            "@shared-enums": ["app/enums/index.ts"]
        }
    },
    "angularCompilerOptions": {
        "fullTemplateTypeCheck": true,
        "strictInjectionParameters": true
    }
}
